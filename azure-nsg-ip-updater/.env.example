# Azure Service Principal — `az ad sp create-for-rbac` will give you these.
# The SP needs the "Network Contributor" role (or a custom role with
# Microsoft.Network/networkSecurityGroups/securityRules/read+write) on the NSG.
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=replace-me
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000

# Which NSG rules to sync lives in a YAML file, not here — see
# config.example.yaml. Defaults to ./config.yaml; uncomment to override.
# NSG_IP_UPDATER_CONFIG=/etc/nsg-ip-updater/config.yaml
