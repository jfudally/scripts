# Azure Service Principal — `az ad sp create-for-rbac` will give you these.
# The SP needs the "Network Contributor" role (or a custom role with
# Microsoft.Network/networkSecurityGroups/securityRules/read+write) on the NSG.
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=replace-me
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000

# Which NSG security rule(s) to keep pointed at this host's public IP.
# AZURE_NSG_RULE_NAMES is comma-separated; all rules must live on the one NSG
# named below. Example single rule: allow-home-ssh
# Example multiple rules: allow-home-ssh,allow-home-https,allow-home-rdp
AZURE_RESOURCE_GROUP=my-rg
AZURE_NSG_NAME=my-nsg
AZURE_NSG_RULE_NAMES=allow-home-ssh,allow-home-https
